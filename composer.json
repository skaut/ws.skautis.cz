{
  "name": "skautis/ws.skautis.cz",
  "type": "project",
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/skaut/Skautis.git",
      "no-api": true
    },
    {
      "type": "vcs",
      "url": "https://github.com/skaut/SkautisNette.git",
      "no-api": true
    }
  ],
  "require": {
    "php": "^8.4",
    "nette/application": "^3.2",
    "nette/bootstrap": "^3.2",
    "nette/caching": "^3.2",
    "nette/di": "^3.2",
    "nette/forms": "^3.2",
    "nette/http": "^3.3",
    "nette/mail": "^4.0",
    "nette/robot-loader": "^4.0",
    "nette/security": "^3.2",
    "nette/utils": "^4.1",
    "skaut/skautis-nette": "^3.1",
    "skaut/skautis": "^3.1",
    "nextras/mail-panel": "^2.7",
    "dibi/dibi": "^3.2.4"
  },
  "minimum-stability": "RC",
  "prefer-stable": true,
  "require-dev": {
    "squizlabs/php_codesniffer": "^4.0.4",
    "slevomat/coding-standard": "^8.31",
    "doctrine/coding-standard": "^14.0"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
